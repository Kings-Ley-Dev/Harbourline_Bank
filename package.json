{
  "name": "harbourline-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web-based banking management and client portal (MERN, Vercel, MongoDB Atlas)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,client -c cyan,yellow \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "node --watch server/dev.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/scripts/seed.js",
    "test": "node --test server/tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
