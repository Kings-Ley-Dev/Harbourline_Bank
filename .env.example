# ---- Required ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/harbourline?retryWrites=true&w=majority
JWT_SECRET=            # long random string: openssl rand -hex 48
APP_URL=https://your-domain.example   # used in activation/reset links (Vercel: set per environment)

# ---- Optional ----
BRAND_NAME=Harbourline Bank
ENCRYPTION_KEY=        # encrypts MFA secrets at rest (defaults to JWT_SECRET)
ENFORCE_ADMIN_MFA=true # staff must enrol in MFA (default true in production)
STATEMENTS_ENABLED=true

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Harbourline Bank <no-reply@your-domain.example>"

# ---- WhatsApp Business Cloud API (approved template with 2 body params: {{1}} name, {{2}} link) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_ACCOUNT_CREATED=account_created

# ---- SMS: choose twilio or arkesel (Ghana-friendly) ----
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
SMS_SENDER_ID=Harbourline
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ---- Seeding ----
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD=
